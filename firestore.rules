rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public writes to bookDownloads collection (for lead capture)
    match /bookDownloads/{document} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    // Allow all access for authenticated users, public read for unauthenticated
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}


