rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.admin == true ||
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin');
    }

    // Allow public collection for AI chat
    match /public/{documentId} {
      allow read, write: if true;
    }

    // Allow public read access to promo codes (needed for pricing page)
    // Allow authenticated write access (admin component verifies admin status)
    match /adminSettings/promoCodes {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read/write their own profile and subcollections (aiChats, etc.)
    // Admins can read/write all profiles
    match /userProfiles/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    match /userProfiles/{userId}/{subcollection=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Allow authenticated users to access their own goals
    // Admins can access all goals
    match /rocketGoals/{goalId} {
      allow read, write: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
    }
    match /rocketGoals/{goalId}/{subcollection=**} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users to read other users (for fans feature, etc.)
    // Admins can read/write all users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Demo requests - allow create for anyone, read/write for authenticated
    match /demoRequests/{requestId} {
      allow create: if true;
      allow read, write: if request.auth != null;
    }

    // Admin settings - admins have full access
    match /adminSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


