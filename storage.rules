rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read and write their own profile images
    match /userProfiles/{userId}/{allPaths=**} {
      allow read: if true; // Allow public read for profile images
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /profile-pictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Allow users to upload goal visualizations (ownership verified in app code)
    match /goal-visualizations/{goalId}/{allPaths=**} {
      allow read: if true; // Allow public read for goal visualizations
      allow write: if request.auth != null; // Authenticated users can upload (app verifies ownership)
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}






